{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": { "type": "builtin", "source": "arch" },
  "modules": [
    {
      "type": "host",
      "key": "󰌢 PC",
      "keyColor": "red",
      "format": "{name}"
    },
    {
      "type": "cpu",
      "key": "│ ├",
      "keyColor": "red"
    },
    {
      "type": "gpu",
      "key": "│ ├󰍛",
      "keyColor": "red"
    },
    {
      "type": "memory",
      "key": "│ ├󰍛",
      "keyColor": "red"
    },
    {
      "type": "disk",
      "key": "└ └",
      "keyColor": "red"
    },
    "break",
    {
      "type": "os",
      "key": " OS",
      "keyColor": "green"
    },
    {
      "type": "kernel",
      "key": "│ ├",
      "keyColor": "green"
    },
    {
      "type": "packages",
      "key": "│ ├󰏖",
      "keyColor": "green"
    },
    {
      "type": "terminal",
      "key": "│ ├",
      "keyColor": "green"
    },
    {
      "type": "shell",
      "key": "│ ├",
      "keyColor": "green"
    },
    {
      "type": "wm",
      "key": "└ └",
      "keyColor": "green"
    },
    "break",
    {
      "type": "publicip",
      "key": "󰌘 ┌󰩟",
      "keyColor": "cyan",
      "format": "{1} - {2}"
    },
    {
      "type": "localip",
      "key": "│ ├󰩟",
      "keyColor": "cyan",
      "format": "{1} - {3}",
      "showMac": true
    },
    {
      "type": "wifi",
      "key": "│ ├󰑩",
      "keyColor": "cyan",
      "format": "{4} - {7} - {13} GHz - {6} - {10}"
    },
    {
      "type": "bluetooth",
      "key": "└ └󰥰",
      "keyColor": "cyan",
      "format": "{1} - {4}"
    },
    "break",
    {
      "type": "uptime",
      "key": " ┌",
      "keyColor": "magenta"
    },
    {
      "type": "command",
      "text": "~/.config/fastfetch/battery",
      "key": "│ ├",
      "keyColor": "magenta"
    },
    {
      "type": "media",
      "key": "│ ├",
      "keyColor": "magenta",
      "format": "{1:-30} ({5}) [{#magenta}{player-name}{#}]"
    },
    {
      "type": "datetime",
      "key": "│ ├",
      "keyColor": "magenta",
      "format": "{23}-{4}-{1} {14}:{18}:{20} {22}"
    },
    {
      "type": "locale",
      "key": "└ └",
      "keyColor": "magenta"
    },
    { "type": "colors", "paddingLeft": 20, "symbol": "star" }
  ]
}
