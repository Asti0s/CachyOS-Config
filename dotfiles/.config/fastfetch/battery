#!/usr/bin/env bash

battery_dir=""
for d in /sys/class/power_supply/BAT*; do
    [ -d "$d" ] && battery_dir="$d" && break
done

if [ -z "$battery_dir" ]; then
    echo "No battery"
    exit 0
fi

status=$(cat "$battery_dir/status" 2>/dev/null)
capacity=$(cat "$battery_dir/capacity" 2>/dev/null)

icon() {
    case "$1" in
        9[0-9]|100) echo "󰁹" ;;
        8[0-9])     echo "󰂂" ;;
        7[0-9])     echo "󰂀" ;;
        6[0-9])     echo "󰁿" ;;
        5[0-9])     echo "󰁾" ;;
        4[0-9])     echo "󰁽" ;;
        3[0-9])     echo "󰁼" ;;
        2[0-9])     echo "󰁻" ;;
        1[0-9])     echo "󰁺" ;;
        *)          echo "󰂎" ;;
    esac
}

case "$1" in
    icon)   icon "$capacity" ;;
    percent) echo "${capacity}%" ;;
    status) echo "$status" ;;
    *)      echo "$(icon "$capacity") ${capacity}% ($status)" ;;
esac
